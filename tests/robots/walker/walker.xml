<mujoco model="walker">
  <compiler angle="radian"/>
  <option timestep="0.002"/>
  <worldbody>
    <!-- The trunk at standing height: with the leg straight the ankle is at z = 0. -->
    <body name="trunk" pos="0 0 0.27">
      <freejoint name="root"/>
      <geom name="trunk" type="box" size="0.08 0.05 0.03" mass="2"/>
      <body name="thigh" pos="0 0 -0.03">
        <joint name="hip" type="hinge" axis="0 1 0" range="-1.6 1.6"/>
        <geom name="thigh" type="capsule" fromto="0 0 0 0 0 -0.12" size="0.015" mass="0.3"/>
        <body name="shin" pos="0 0 -0.12">
          <joint name="knee" type="hinge" axis="0 1 0" range="-2.2 0"/>
          <geom name="shin" type="capsule" fromto="0 0 0 0 0 -0.12" size="0.012" mass="0.2"/>
          <geom name="foot" type="box" size="0.03 0.02 0.005" pos="0.01 0 -0.12" mass="0.05"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
